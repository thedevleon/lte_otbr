/ {
	aliases {
		modem = &modem;
	};

	chosen {
		zephyr,entropy = &rng;
	};
};

&uart30 {
	status = "okay";
	/* 921600 requires the modem's +IPR to be programmed to 921600 once
	 * (stored in modem NVM) BEFORE flashing this — see AGENTS.md.
	 * HW flow control is mandatory above 115200. */
	current-speed = <921600>;
	zephyr,pm-device-runtime-auto;
	hw-flow-control;
};

&modem {
	status = "okay";
	zephyr,pm-device-runtime-auto;
};

&psa_rng {
	status = "disabled";
};

&rng {
	status = "okay";
};

&xo {
	status = "okay";
};

&lfclk {
	status = "okay";
};

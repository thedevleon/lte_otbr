+# Border Router platform files from Zephyr (NXP integration), not yet referenced by NCS
+# trel.c and dhcp6_pd.c are intentionally omitted: TREL and DHCPv6-PD are disabled and
+# those sources require newer OpenThread APIs than the bundled sdk-openthread fork provides.
+zephyr_library_sources_ifdef(CONFIG_OPENTHREAD_ZEPHYR_BORDER_ROUTER
+  ${ZEPHYR_BASE}/modules/openthread/platform/infra_if.c
+  ${ZEPHYR_BASE}/modules/openthread/platform/udp.c
+  ${ZEPHYR_BASE}/modules/openthread/platform/mdns_socket.c
